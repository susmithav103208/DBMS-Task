```sql
USE DBMS;

CREATE OR REPLACE VIEW Product_Sales_Report AS
SELECT
    p.Product_ID,
    p.Product_Name,
    p.Category,
    SUM(o.Quantity) AS Total_Quantity_Sold,
    SUM(o.Quantity * p.Price) AS Total_Sales
FROM Product p
LEFT JOIN Orders o ON p.Product_ID = o.Product_ID
GROUP BY p.Product_ID, p.Product_Name, p.Category;

CREATE OR REPLACE VIEW Customer_Purchase_Report AS
SELECT
    c.Customer_ID,
    c.Customer_Name,
    COUNT(o.Order_ID) AS Total_Orders,
    COALESCE(SUM(pay.Payment_Amount), 0) AS Total_Paid
FROM Customer c
LEFT JOIN Orders o ON c.Customer_ID = o.Customer_ID
LEFT JOIN Payment pay
    ON o.Order_ID = pay.Order_ID
    AND pay.Payment_Status = 'Paid'
GROUP BY c.Customer_ID, c.Customer_Name;

DELIMITER //

CREATE PROCEDURE Process_Order(
    IN p_Order_ID INT,
    IN p_Customer_ID INT,
    IN p_Product_ID INT,
    IN p_Quantity INT
)
BEGIN
    IF p_Quantity <= 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Quantity must be greater than zero';
    ELSE
        INSERT INTO Orders (Order_ID, Customer_ID, Product_ID, Order_Date, Quantity)
        VALUES (p_Order_ID, p_Customer_ID, p_Product_ID, CURDATE(), p_Quantity);
    END IF;
END //

CREATE FUNCTION Calculate_Product_Sales(p_Product_ID INT)
RETURNS DECIMAL(12,2)
DETERMINISTIC
READS SQL DATA
BEGIN
    DECLARE total_sales DECIMAL(12,2);

    SELECT COALESCE(SUM(pay.Payment_Amount), 0)
    INTO total_sales
    FROM Orders o
    JOIN Payment pay ON o.Order_ID = pay.Order_ID
    WHERE o.Product_ID = p_Product_ID
      AND pay.Payment_Status = 'Paid';

    RETURN total_sales;
END //

CREATE TRIGGER Validate_Order_Quantity
BEFORE INSERT ON Orders
FOR EACH ROW
BEGIN
    IF NEW.Quantity <= 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Order quantity must be greater than zero';
    END IF;
END //

DELIMITER ;

SELECT * FROM Product_Sales_Report;
SELECT * FROM Customer_Purchase_Report;

SELECT Calculate_Product_Sales(201) AS Product_Total_Sales;

SHOW PROCEDURE STATUS
WHERE Db = DATABASE() AND Name = 'Process_Order';

SHOW FUNCTION STATUS
WHERE Db = DATABASE() AND Name = 'Calculate_Product_Sales';

SHOW TRIGGERS;
```
