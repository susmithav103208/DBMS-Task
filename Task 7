SELECT * FROM Product;

SELECT Product_Name, Price
FROM Product;

SELECT * FROM Product
WHERE Price > 1000;

SELECT * FROM Product
WHERE Category = 'Electronics';

SELECT * FROM Product
WHERE Stock > 0;

SELECT * FROM Product
WHERE Stock = 0;

SELECT * FROM Product
ORDER BY Price ASC;

SELECT * FROM Product
ORDER BY Price DESC;

SELECT DISTINCT Category
FROM Product;

SELECT DISTINCT City
FROM Customer;

SELECT * FROM Product
WHERE Price BETWEEN 500 AND 3000;

SELECT * FROM Product
WHERE Category = 'Electronics'
AND Price < 3000;

SELECT * FROM Product
WHERE Stock > 0
AND Price < 5000;

SELECT * FROM Product
WHERE Product_Name LIKE '%phone%';

SELECT Customer_ID, Customer_Name, Email, City
FROM Customer;

SELECT o.Order_ID, c.Customer_Name, p.Product_Name, o.Quantity, o.Order_Date
FROM Orders o
JOIN Customer c ON o.Customer_ID = c.Customer_ID
JOIN Product p ON o.Product_ID = p.Product_ID;

SELECT p.Category, COUNT(p.Product_ID) AS Total_Products
FROM Product p
GROUP BY p.Category;

SELECT p.Category, AVG(p.Price) AS Average_Price
FROM Product p
GROUP BY p.Category;

SELECT p.Product_Name, p.Price, p.Stock
FROM Product p
WHERE p.Stock > 0
ORDER BY p.Price DESC;

SELECT c.Customer_Name, COUNT(o.Order_ID) AS Total_Orders
FROM Customer c
LEFT JOIN Orders o ON c.Customer_ID = o.Customer_ID
GROUP BY c.Customer_ID, c.Customer_Name;

SELECT p.Product_Name, SUM(o.Quantity) AS Total_Quantity_Sold
FROM Product p
JOIN Orders o ON p.Product_ID = o.Product_ID
GROUP BY p.Product_ID, p.Product_Name
ORDER BY Total_Quantity_Sold DESC;