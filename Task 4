    Total_Price = 3 * Unit_Price
WHERE Order_Detail_ID = 1;

UPDATE Orders
SET Total_Amount = (SELECT SUM(Total_Price) FROM Order_Details WHERE Order_ID = 1)
WHERE Order_ID = 1;

